.venv/
.test-deps/
__pycache__/
*.py[cod]
.pytest_cache/
uploads/

# Build output. Reproducible from `uv build`; never commit a wheel or sdist,
# because a committed artifact can drift from the commit it claims to be built
# from and then gets mistaken for a release.
dist/
build/

# Editor-local task definitions. Generated per-machine and easy to duplicate;
# the canonical build/test commands live in README.md and .github/workflows/ci.yml.
.vscode/

# Proprietary Benro firmware regions — extracted locally from
# pgphoto.stage2ondisk in the private research repo. Never commit to GitHub.
# Each has a committed .json sidecar (coordinates + hashes only) and a
# .placeholder documenting retrieval; the .bin itself stays local.
# Listed explicitly rather than via *.bin so a new synthetic test fixture is
# never silently un-addable on a fresh clone.
tests/fixtures/arm/stage2_region.bin
tests/fixtures/arm/capture_bulb_image_region.bin

# Generated SD card images from sd_emulator write_to(). These are sparse and can
# be tens of gigabytes logically; never commit one.
*.sdcard.img
tests/fixtures/sd/*.img
